<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.pantrypal">

    <!-- 🌐 INTERNET (AI + API calls) -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 📷 CAMERA (OCR / Scan feature) -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- 🔔 NOTIFICATIONS (Expiry alerts - Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Camera optional -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PantryPal">

        <!-- 🚀 SPLASH (Launcher) -->
        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.PantryPal.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 🔐 AUTH -->
        <activity
            android:name=".LoginActivity"
            android:exported="true" />

        <!-- 🏠 MAIN -->
        <activity
            android:name=".MainActivity"
            android:exported="true" />

        <!-- 📷 SCAN -->
        <activity
            android:name=".ui.BillScanActivity"
            android:exported="false" />

        <activity
            android:name=".ui.AddItemOptionsActivity"
            android:exported="false" />

        <!-- 🧺 PANTRY -->
        <activity
            android:name=".AddItemActivity"
            android:exported="false" />

        <activity
            android:name=".PantryListActivity"
            android:exported="false" />

        <!-- 🤖 AI -->
        <activity
            android:name=".RecipeSuggestionActivity"
            android:exported="false" />

        <activity
            android:name=".SavedRecipesActivity"
            android:exported="false" />

        <activity
            android:name=".RecipeDetailActivity"
            android:exported="false" />

        <!-- 👤 PROFILE -->
        <activity
            android:name=".ui.profile.EditProfileActivity"
            android:exported="false" />

    </application>

</manifest>