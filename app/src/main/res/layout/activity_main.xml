<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main_gradient"
    android:padding="20dp">

    <!-- Title -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PantryPal"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/pp_text"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- Subtitle -->
    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Manage pantry. Save money. Cook smarter."
        android:textSize="14sp"
        android:textColor="@color/pp_text_muted"
        android:layout_marginTop="6dp"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        app:cardBackgroundColor="@color/pp_card"
        app:cardCornerRadius="22dp"
        app:strokeColor="#22304A"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toBottomOf="@id/tvSubtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <!-- Add Item -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddItem"
                style="@style/PP_PrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Add Pantry Item"
                app:icon="@drawable/ic_add_24"
                app:iconGravity="textStart"
                app:iconPadding="12dp"
                app:backgroundTint="@color/pp_primary"/>

            <!-- View Pantry -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnViewPantry"
                style="@style/PP_PrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="View Pantry"
                app:icon="@drawable/ic_inventory_24"
                app:iconGravity="textStart"
                app:iconPadding="12dp"
                app:backgroundTint="@color/pp_primary"/>

            <!-- AI Recipe -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRecipe"
                style="@style/PP_PrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="AI Recipe Suggestions"
                app:icon="@drawable/ic_restaurant_24"
                app:iconGravity="textStart"
                app:iconPadding="12dp"
                app:backgroundTint="@color/pp_primary"/>

            <!-- Shopping -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnShoppingList"
                style="@style/PP_PrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Shopping List"
                app:icon="@drawable/ic_list_24"
                app:iconGravity="textStart"
                app:iconPadding="12dp"
                app:backgroundTint="@color/pp_primary"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="16dp"/>

            <!-- Logout -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogout"
                style="@style/PP_PrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Logout"
                app:icon="@drawable/ic_logout_24"
                app:iconGravity="textStart"
                app:iconPadding="12dp"
                app:backgroundTint="@color/pp_danger"/>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
