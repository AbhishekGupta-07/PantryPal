<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#121212"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PantryPal"
        android:textSize="26sp"
        android:textColor="@android:color/white"
        android:textStyle="bold"
        android:layout_marginBottom="40dp"/>

    <Button
        android:id="@+id/btnAddItem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Add Pantry Item"/>

    <Button
        android:id="@+id/btnViewPantry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="View Pantry"
        android:layout_marginTop="16dp"/>

    <Button
        android:id="@+id/btnRecipe"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="AI Recipe Suggestions"
        android:layout_marginTop="16dp"/>

    <!-- ✅ NEW SHOPPING LIST BUTTON -->
    <Button
        android:id="@+id/btnShoppingList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Shopping List"
        android:layout_marginTop="16dp"/>

</LinearLayout>
